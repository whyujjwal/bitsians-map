# Public URL of the deployed site: used for canonical links, og:url and the sitemap.
SITE_URL=https://bitsians-map.whyujjwalraj.workers.dev

# Optional. Leave unset and the site shows nothing about referrals.
# A form (Google Forms, Tally, ...) where a student says they want a referral at a company.
# "{company}" is replaced with the company name, so the form can be prefilled.
# PUBLIC_REFERRAL_FORM_URL=https://example.com/referral-waitlist?company={company}
# A form where alumni say they would refer juniors.
# PUBLIC_ALUMNI_FORM_URL=https://example.com/alumni-interest
