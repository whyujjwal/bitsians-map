---
import Base from '../../layouts/Base.astro';
import raw from '../../data/companies.json';
import TopBar from '../../components/TopBar.astro';
import TrackControls from '../../components/TrackControls.svelte';
import Roles from '../../components/Roles.svelte';
import '../../styles/site.css';
import jobsData from '../../data/jobs.json';
import {
  initials, isInactive, tileKind, isHiring, rolesOf, jobsUrlOf, referralFormUrl,
  ATS_NAME, ROLES_FETCHED_AT, ROLES_MAX_AGE_DAYS, batchTag, fixUrl,
} from '../../lib/data';
import type { CompanyJobs } from '../../lib/jobs';

export function getStaticPaths() {
  return (raw as any[]).map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props as { c: any };
const status = isInactive(c.status) ? c.status[0].toUpperCase() + c.status.slice(1) : '';
const kind = tileKind(c);
const hiring = isHiring(c);
const roles = rolesOf(c.id);
const jobs = roles != null ? ((jobsData as any).companies[c.id] as CompanyJobs | undefined) : undefined;
const jobsUrl = jobsUrlOf(c);
const referral = hiring ? referralFormUrl(c.name) : '';
const place = [c.city, c.country].filter(Boolean).join(', ');
const hasPos = c.lat != null && c.lng != null;
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const founderNames = c.founders.map((f: any) => f.name).join(', ');
const title = `${c.name} | BITSians Startup Map`;
const description = (
  `${c.name}${c.oneLine ? ': ' + c.oneLine.replace(/\.$/, '') : ''}. ` +
  [c.sector, c.stage, place].filter(Boolean).join(', ') + '.' +
  (founderNames ? ` Founded by BITS Pilani alumni ${founderNames}.` : '') +
  (roles ? ` Hiring: ${roles} open ${roles === 1 ? 'role' : 'roles'}.` : hiring ? ' Hiring.' : '')
).slice(0, 300);
const sameAs = [c.website].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: c.name,
  ...(c.oneLine && { description: c.oneLine }),
  ...(c.website && { url: c.website }),
  ...(sameAs.length && { sameAs }),
  ...(c.founded && { foundingDate: c.founded }),
  ...(place && { location: { '@type': 'Place', name: place } }),
  ...(c.founders.length && { founder: c.founders.map((f: any) => ({ '@type': 'Person', name: f.name, ...(f.role && { jobTitle: f.role }) })) }),
};

// Sharing: founders post their page when they hire, students pass it around.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareText = hiring ? `${c.name} is hiring. Open roles and founders:` : `${c.name} on the BITSians Startup Map:`;
const linkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
const whatsApp = `https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}`;

// Ways on from this page: the same sector, campus or city in the company list.
const list = (k: string, v: string) => `/?tab=companies&${k}=${encodeURIComponent(v)}`;
const more: [string, string][] = [
  ...(c.sector && c.sector !== 'Other' ? [[`More ${c.sector} companies`, list('sector', c.sector)] as [string, string]] : []),
  ...(c.campuses as string[]).map((k): [string, string] => [`More from ${k}`, list('campus', k)]),
  ...(c.city ? [[`More in ${c.city}`, list('city', c.city)] as [string, string]] : []),
  ['All open roles', '/'],
];
---
<Base {title} {description} {jsonLd}>
  <div class="site">
    <TopBar />
    <div class="fwrap">
      <article class="fstage cp">
        {hiring && (
          <p class="banner">
            <i class="dot" aria-hidden="true"></i>
            <span>Hiring now{roles && <span data-roles-fetched={ROLES_FETCHED_AT} data-roles-max-days={ROLES_MAX_AGE_DAYS}>, {roles} open {roles === 1 ? 'role' : 'roles'}</span>}</span>
          </p>
        )}
        <header class="cp-head">
          {c.logo
            ? <span class={`tile logo t-xl ${kind}${c.logoDark ? ' dark' : ''}`} aria-hidden="true"><img src={c.logo} alt="" width="50" height="50" decoding="async" /></span>
            : <span class={`tile t-xl ${kind}`} aria-hidden="true">{initials(c.name)}</span>}
          <div class="cp-title">
            <h1>{c.name}</h1>
            {c.website && <a class="dsite" href={c.website} target="_blank" rel="noopener noreferrer">{host(c.website)}</a>}
          </div>
        </header>
        {c.oneLine && <p class="cp-one">{c.oneLine}</p>}
        <p class="facts">
          {c.stage && <span>{c.stage}</span>}
          {c.sector && <span>{c.sector}</span>}
          {place && <span>{place}</span>}
          {c.founded && <span>Founded {c.founded}</span>}
          {status && <span class="st">{status}</span>}
        </p>

        <div class="cp-cols">
          <div class="cp-main">
            {jobs && (
              <section aria-labelledby="rh" class="rsec" data-roles-fetched={ROLES_FETCHED_AT} data-roles-max-days={ROLES_MAX_AGE_DAYS}>
                <h2 id="rh">Open roles ({jobs.jobs.length})</h2>
                <Roles client:visible id={c.id} preload={jobs} />
              </section>
            )}
            <section aria-labelledby="th">
              <h2 id="th">{jobs ? 'Your application' : hiring ? 'Open roles' : 'Keep track of it'}</h2>
              <div class="dsec">
                <TrackControls client:load id={c.id} name={c.name} careers={jobsUrl}
                  quiet={!!jobs} cta={jobs ? `See all on ${ATS_NAME[jobs.ats] ?? 'their careers page'}` : 'View open roles'} />
              </div>
            </section>
            {referral && (
              <p class="refer">Want a BITSian here to refer you? Referrals aren't open yet. <a href={referral} target="_blank" rel="noopener noreferrer">Join the waitlist</a></p>
            )}
          </div>

          <aside class="cp-side">
            {c.founders.length > 0 && (
              <section aria-labelledby="fh">
                <h2 id="fh">{c.founders.length === 1 ? 'Founder' : 'Founders'}</h2>
                <ul class="founders">
                  {c.founders.map((f: any) => {
                    const b = batchTag(f);
                    return (
                      <li>
                        <span class="fwho"><span class="fname">{f.name}</span>{f.role && <span class="frole">{f.role}</span>}</span>
                        {b.text && <span class="batch" title={b.title}>{b.text}</span>}
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            <section aria-labelledby="shh" class="cp-share">
              <h2 id="shh">Share this page</h2>
              <p>{hiring ? `Know someone who should work at ${c.name}? Send them here.` : `Pass ${c.name} on to someone who should see it.`} If you founded it, post this when you hire.</p>
              <p class="cp-sharebtns">
                <button class="tbtn" data-copy={pageUrl}>Copy link</button>
                <a class="tbtn" href={linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a class="tbtn" href={whatsApp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
              </p>
            </section>

            {c.sources?.length > 0 && (
              <section aria-labelledby="sh">
                <h2 id="sh">Sources</h2>
                <ul class="sources">
                  {c.sources.map((u: string) => <li><a href={u} target="_blank" rel="noopener noreferrer">{u.replace(/^https?:\/\/(www\.)?/, '')}</a></li>)}
                </ul>
              </section>
            )}
          </aside>
        </div>

        <p class="dfoot">
          {hasPos ? <a href={`/map?c=${encodeURIComponent(c.id)}`}>See it on the map</a> : <span></span>}
          <a class="fix" href={fixUrl(c)} target="_blank" rel="noopener noreferrer">Something wrong? Suggest a fix</a>
        </p>
      </article>

      <nav class="cp-more" aria-labelledby="mh">
        <h2 id="mh">Keep looking</h2>
        <ul>
          {more.map(([label, href]) => <li><a class="chip" href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <footer class="foot cp-foot">Free for every BITSian, always. Independent community project, not affiliated with BITS Pilani.</footer>
    </div>
  </div>
  <script is:inline>
    // This page is static, so its role list is from the last build. The front page stops showing
    // roles ROLES_MAX_AGE_DAYS after they were fetched; drop them here at the same point.
    for (const s of document.querySelectorAll('[data-roles-fetched]')) {
      if (!(Date.now() - Date.parse(s.dataset.rolesFetched) < s.dataset.rolesMaxDays * 864e5)) s.remove();
    }
    for (const b of document.querySelectorAll('[data-copy]')) {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'Link copied'; }
        catch { prompt('Copy this link', b.dataset.copy); return; }
        setTimeout(() => { b.textContent = 'Copy link'; }, 2000);
      });
    }
  </script>
</Base>
