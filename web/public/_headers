# Content-hashed build assets never change at a given URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The maplibre worker is copied in without a content hash: cache for a day,
# serve stale while revalidating for a week.
/maplibre/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Map styles and company logos aren't content-hashed either; they change rarely.
/map/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
